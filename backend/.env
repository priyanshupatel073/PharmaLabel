# ==============================================================================
# PHARMALABEL PRO - LIVE SMTP CREDENTIALS
# ==============================================================================
# When empty, generated passwords are saved to backend/logs/sent_emails.log
# When filled, emails are sent directly to recipient inboxes via SSL/TLS SMTP.
# ==============================================================================

MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PharmLabel Pro Cloud
SMTP_DEBUG=false
